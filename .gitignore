# The directory Mix will write compiled artifacts to. Unanchored so nested
# applications (packages/*) are covered too.
_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to. Unanchored so nested
# applications (packages/*) are covered too.
deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# Dialyzer PLTs live outside _build so CI can cache them.
/priv/plts/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
/*.tar


# Scratch workspace for the executing-plans/subagent-driven-development skills.
/.superpowers/

# Process notes (specs and plans) stay local; they are not part of the library.
/docs/superpowers/
